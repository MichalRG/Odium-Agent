{
  "version": 2,
  "verification": {
    "autodetect": false,
    "require_project_checks": true,
    "commands": [
      {
        "name": "verify-all",
        "argv": [
          "bash",
          "scripts/verify.sh"
        ],
        "cwd": "."
      }
    ]
  },
  "safety": {
    "blocked_paths": [
      "AGENTS.md",
      "CLAUDE.md",
      "GEMINI.md",
      "nest.config.json",
      "ai_nest/",
      ".agents/",
      ".claude/",
      ".github/workflows/",
      ".gitignore",
      ".github/",
      ".cursor/",
      "scripts/verify.sh",
      "scripts/verify.py",
      "scripts/verify.config.json",
      "scripts/verify.config.json.example",
      "scripts/security.sh",
      ".pre-commit-config.yaml",
      "scripts/",
      "Makefile",
      "Dockerfile",
      "requirements*.txt",
      "*.lock",
      "install.py"
    ],
    "bootstrap_creatable_paths": [
      ".gitignore",
      "*.lock",
      "requirements*.txt"
    ],
    "protected_basenames": [
      ".ruff.toml",
      "angular.json",
      "conftest.py",
      "jest.config.js",
      "jest.config.ts",
      "karma.conf.cjs",
      "karma.conf.js",
      "mypy.ini",
      "package-lock.json",
      "package.json",
      "playwright.config.js",
      "playwright.config.ts",
      "pnpm-lock.yaml",
      "poetry.lock",
      "pyproject.toml",
      "pytest.ini",
      "ruff.toml",
      "setup.cfg",
      "tox.ini",
      "tsconfig.json",
      "tsconfig.spec.json",
      "uv.lock",
      "vite.config.ts",
      "vitest.config.js",
      "vitest.config.ts",
      "yarn.lock",
      "dockerfile",
      "dockerfile*",
      "makefile",
      "requirements*.txt",
      "requirements.txt",
      "pom.xml",
      "mvnw",
      "mvnw.cmd",
      "maven-wrapper.properties",
      "maven-wrapper.jar",
      "build.gradle",
      "build.gradle.kts",
      "settings.gradle",
      "settings.gradle.kts",
      "gradle.properties",
      "gradlew",
      "gradlew.bat",
      "gradle-wrapper.properties",
      "gradle-wrapper.jar",
      "go.mod",
      "go.sum",
      ".golangci.yml",
      ".golangci.yaml",
      "*.csproj",
      "*.sln",
      "directory.build.props",
      "directory.packages.props",
      "nuget.config",
      "eslint.config.js",
      "eslint.config.mjs",
      "eslint.config.cjs",
      "eslint.config.ts",
      ".eslintrc*"
    ],
    "allow_existing_test_modifications": false,
    "test_path_globs": [
      "tests/**",
      "*_test.go",
      "**/*_test.go",
      "**/testdata/**",
      "*.Tests/**",
      "**/*.Tests/**",
      "test/**",
      "**/tests/**",
      "**/test/**",
      "**/__tests__/**",
      "**/e2e/**",
      "**/integration_tests/**",
      "test_*.py",
      "**/test_*.py",
      "*_test.py",
      "**/*_test.py",
      "*.feature",
      "**/*.feature",
      "*.spec.ts",
      "**/*.spec.ts",
      "*.spec.tsx",
      "**/*.spec.tsx",
      "*.test.ts",
      "**/*.test.ts",
      "*.test.tsx",
      "**/*.test.tsx",
      "*.spec.js",
      "**/*.spec.js",
      "*.test.js",
      "**/*.test.js",
      "*.spec.jsx",
      "**/*.spec.jsx",
      "*.test.jsx",
      "**/*.test.jsx"
    ],
    "allow_new_test_fixtures_in_ci": false
  },
  "limits": {
    "max_repair_attempts": 2,
    "agent_timeout_seconds": 1800,
    "agent_max_seconds": 14400,
    "review_diff_max_chars": 400000,
    "check_timeout_seconds": 4830
  },
  "models": {
    "codex": {
      "default": {"model": "gpt-6.1-sol", "effort": "medium"},
      "explore": {"model": "gpt-6-luna", "effort": "high"},
      "specify": {"model": "gpt-6-astra", "effort": "high"},
      "plan": {"model": "gpt-6-astra", "effort": "high"},
      "tests": {"model": "gpt-6.1-sol", "effort": "high"},
      "implement": {"model": "gpt-6.1-sol", "effort": "high"},
      "repair": {"model": "gpt-6.1-sol", "effort": "medium"},
      "review": {"model": "gpt-6.1-sol", "effort": "high"},
      "security_review": {"model": "gpt-6-astra", "effort": "high"}
    },
    "claude": {
      "default": {"model": "claude-sonnet-5-5", "effort": "medium"},
      "explore": {"model": "claude-sonnet-5-5", "effort": "medium"},
      "specify": {"model": "claude-opus-5-5", "effort": "high"},
      "plan": {"model": "claude-opus-5-5", "effort": "high"},
      "tests": {"model": "claude-sonnet-5-5", "effort": "high"},
      "implement": {"model": "claude-opus-5-5", "effort": "medium"},
      "repair": {"model": "claude-opus-5-5", "effort": "medium"},
      "review": {"model": "claude-opus-5-5", "effort": "high"},
      "security_review": {"model": "claude-fable-5-2", "effort": "high"}
    }
  },
  "tdd": {
    "enabled": true,
    "protected_tests": false,
    "red_commands": [
      {
        "name": "public-tdd-red",
        "argv": [
          "bash",
          "scripts/verify.sh",
          "--suite",
          "unit"
        ],
        "cwd": "."
      }
    ],
    "accepted_red_exit_codes": [
      1,
      2
    ],
    "already_green_policy": "block"
  },
  "review_policy": {
    "blocking_severities": [
      "critical",
      "high"
    ],
    "skip_recheck_without_protected_tests": true
  },
  "routing": {
    "always_security_review": false,
    "security_review_patterns": [
      "*.tf",
      "*.tfvars",
      "*auth*",
      "*security*",
      "*permission*",
      "*secret*",
      "*iam*",
      "*tenant*",
      "*middleware*",
      "*crypt*",
      "*token*",
      "*login*",
      "*payment*",
      "*migration*",
      "*.sql"
    ]
  },
  "policy_version": "2026-11",
  "environment": {
    "setup_commands": []
  },
  "cleanup": {
    "blocked_worktrees": true
  }
}
